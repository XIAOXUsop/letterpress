---
/**
 * 页面骨架。
 *
 * 有两件事**必须**在这里做对：
 *
 * 1. `<html lang>`——浏览器的中文标点挤压、断行规则、以及
 *    `text-autospace` 都依赖正确的语言标签。写错了不会报错，
 *    只是所有中文排版规则静默失效。
 *
 * 2. 主题恢复脚本放在 `<head>` 且同步执行。放到 `<body>` 末尾或加 defer
 *    会导致首屏先按默认主题绘制、再切换——用户看到一下白一下黑（FOWT）。
 *    这类闪烁在暗色模式下尤其刺眼。
 */
import { site } from '../config.js';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CodeCopy from '../components/CodeCopy.astro';
import { path, absolute } from '../lib/url.js';
// 顺序有讲究：
// fonts.css 必须先于 tokens.css —— 它定义 @font-face，而令牌里的字体栈引用这些族名
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  /** 页面主类型，用于 og:type */
  type?: 'website' | 'article';
  /** 文章页传入发布时间 */
  publishedTime?: Date;
  /** 文章页传入最后修改时间。竞品普遍输出它，能区分「刚发布」与「发布后大改」 */
  modifiedTime?: Date;
  /** 分享图路径（相对本站）。不传则用站点默认图 `/og.png` */
  ogImage?: string;
  /**
   * 这一页是否有 markdown 孪生文件。
   *
   * **只有文章页与知识库条目页才有**（它们各自有对应的 `.md` 路由）。
   * 首页、关于页、归档页没有——早先这里无条件输出 `rel="alternate"`，
   * 于是那些页面的 `<link rel="alternate">` 全部指向 404 的地址。
   * 一个指向不存在文件的 alternate 链接，比没有更糟：它会让 agent
   * 去抓一个 404，然后据此判断这个站不可靠。
   */
  markdownTwin?: boolean;
}

const {
  title,
  description = site.tagline,
  type = 'website',
  publishedTime,
  modifiedTime,
  ogImage,
  markdownTwin = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.title}` : site.title;
/*
 * 404 页的 canonical 要指向站点首页。
 *
 * 指向 `/404/` 的话，那个地址本身返回 404——canonical 的作用是告诉搜索
 * 引擎「哪个才是正本」，而指向一个不存在的地址等于把它引向死路。
 * 对不存在的内容，正确做法是「这一页没有正本」或指向上一级。
 */
const isNotFound = Astro.url.pathname.replace(/\/$/, '').endsWith('/404');
const canonical = isNotFound
  ? absolute('/', site.url) || `https://example.com/`
  : new URL(Astro.url.pathname, Astro.site ?? `https://example.com`).href;

// 同 URL 的 markdown 版本。给人和 agent 都留一个显式入口，
// 而不是让他们猜「带上 Accept 头会怎样」。
const markdownHref = `${Astro.url.pathname.replace(/\/$/, '')}.md`;

const rssHref = absolute('/rss.xml', site.url);
const sitemapHref = absolute('/sitemap-index.xml', site.url);
const faviconSvg = path('/favicon.svg');
const faviconIco = path('/favicon.ico');

/**
 * 分享图的绝对地址。
 *
 * **必须是绝对 URL**——社交平台不会去猜相对路径该拼在哪，
 * 给相对地址等于没有。而绝对地址需要知道站点域名，所以
 * `site.url` 为空时**干脆不输出 og:image**，而不是输出一个
 * 指向 localhost 的地址（那会在生产环境里变成坏图）。
 *
 * 构建时已经有警告提示用户去填 site.url，这里不重复提醒。
 */
const shareImage = site.url ? absolute(ogImage ?? '/og.png', site.url) : null;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/*
      404 页要 noindex。
      上一轮把它的 canonical 从「指向 404」改成「指向首页」，方向对了，
      但只改 canonical 还不够——一个内容不存在的地址被搜索引擎收录，
      用户搜到点进来还是空页。对不存在的内容，规范做法是**明确表示不要收录**。
    */}
    {isNotFound && <meta name="robots" content="noindex" />}

    {/*
      favicon 必须显式引用。
      浏览器只会隐式请求 /favicon.ico，而 `public/favicon.svg` 不会被自动加载——
      少了这一行，那个 SVG 文件永远不会被用到。
    */}
    <link rel="icon" href={faviconSvg} type="image/svg+xml" />
    <link rel="icon" href={faviconIco} sizes="32x32" />

    {/*
      告诉 agent 这里还有一份 markdown 版本。
      rel="alternate" 是标准做法，比在页面里塞说明文字可靠。

      **只在真的有孪生文件时才输出**——否则就是指向 404 的假承诺。
    */}
    {markdownTwin && <link rel="alternate" type="text/markdown" href={markdownHref} />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />

    {/*
      有分享图才用大卡片。写死 `summary_large_image` 而没有图，
      Twitter 会退回一张灰色的空卡片，比小卡片更难看。
    */}
    {shareImage ? (
      <>
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={shareImage} />
      </>
    ) : (
      <meta name="twitter:card" content="summary" />
    )}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <link rel="alternate" type="application/rss+xml" title={site.title} href={rssHref} />
    {site.url && <link rel="sitemap" type="application/xml" href={sitemapHref} />}

    <script is:inline>
      // 同步执行，必须在首屏绘制之前跑完。
      // 顺序：先看用户显式选择，再看系统偏好。
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          // 隐私模式下 localStorage 可能不可用。忽略即可——
          // 拿不到偏好就用系统偏好，不该因此报错。
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <SiteHeader />
    <main class="main" id="main">
      <div class="page">
        <slot />
      </div>
    </main>
    <SiteFooter />
    <CodeCopy />
  </body>
</html>
