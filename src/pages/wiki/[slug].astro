---
/**
 * 知识层条目页。
 *
 * 与文章页结构基本相同，差别在于：
 * - 不显示日期（知识层的价值不在时效）
 * - 显示 outward links（它指向谁），因为它是一张网上的节点
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatContentDate } from '../../lib/date.js';
import { path } from '../../lib/url.js';
import Backlinks from '../../components/Backlinks.astro';
import MarkdownActions from '../../components/MarkdownActions.astro';
import Provenance from '../../components/Provenance.astro';
import JsonLd from '../../components/JsonLd.astro';
import {
  updatedOfDoc,
  kindOf,
  tagsOf,
  loadContent,
  ogImageOf,
  publishedWiki,
  reportIssues,
  type SiteContent,
} from '../../lib/content.js';

export async function getStaticPaths() {
  const content = await loadContent();
  reportIssues(content.issues);

  return publishedWiki(content).map((doc) => ({
    params: { slug: doc.slug },
    props: { doc, content },
  }));
}

interface Props {
  doc: (Awaited<ReturnType<typeof loadContent>>)['docs'][number];
  content: SiteContent;
}

const { doc, content } = Astro.props;
const entry = content.entries.get(doc.slug);

if (!entry) {
  throw new Error(`找不到 slug 为「${doc.slug}」的知识库条目。`);
}

const { Content } = await render(entry);
const updated = updatedOfDoc(content, doc.slug);
const kind = kindOf(content, doc.slug);
const tags = tagsOf(content, doc.slug);

const KIND_LABELS: Record<string, string> = {
  concept: '概念',
  entity: '条目',
  synthesis: '综述',
};

// 它指向谁。与「被引用」相对，合起来能看到这张网上的一个完整节点。
const outgoing = [...(content.graph.outbound.get(doc.slug) ?? [])]
  .map((slug) => content.graph.bySlug.get(slug))
  .filter((d): d is NonNullable<typeof d> => d !== undefined)
  .sort((a, b) => (a.title < b.title ? -1 : 1));

const markdownHref = `${Astro.url.pathname.replace(/\/$/, '')}.md`;
---

<BaseLayout
  title={doc.title}
  description={doc.summary}
  type="article"
  modifiedTime={updated ?? undefined}
  ogImage={ogImageOf(content, doc.slug)}
  markdownTwin
>
  {/*
    `data-pagefind-body` 把搜索索引的范围**限定在这一篇正文里**。

    不加的话 Pagefind 会索引整页——包括跳转链接、导航、页脚的导航文字，
    于是搜索结果的摘要变成「跳到主要内容 此间札记. 内容协商. 概念-…」
    这种把版面文字当正文的碎片。**索引范围决定了摘要质量**，
    而摘要是用户判断「这条是不是我要找的」的唯一依据。
  */}
  <article data-pagefind-body>
    <header class="post-header">
      <h1 class="post-header__title" data-pagefind-meta="title">{doc.title}</h1>
      <div class="meta post-header__meta" data-pagefind-ignore>
        <span>{kind ? KIND_LABELS[kind] ?? kind : '条目'}</span>
        <span class="meta__sep">·</span>
        <span>{doc.slug}</span>
        {
          updated && (
            <>
              <span class="meta__sep">·</span>
              <span>
                修订于
                {formatContentDate(updated, { dateStyle: 'medium' })}
              </span>
            </>
          )
        }
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      outgoing.length > 0 && (
        <section class="backlinks" aria-labelledby="outgoing-title" data-pagefind-ignore>
          <h2 class="backlinks__title" id="outgoing-title">
            这一条指向（{outgoing.length}）
          </h2>
          <ul class="backlinks__list">
            {outgoing.map((target) => (
              <li>
                <a href={path(target.kind === 'wiki' ? `/wiki/${target.slug}/` : `/${target.slug}/`)}>
                  {target.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!--
      知识库条目的结构化数据。**2026-09-24 补的**——
      此前这一类页面完全没有 JSON-LD（wiki 路由没引入该组件），
      而文章页有。搜索引擎与 agent 因此拿不到知识页的结构。
    -->
    <JsonLd
      type="note"
      title={doc.title}
      description={doc.summary}
      url={Astro.url.pathname}
      modifiedTime={updated ?? undefined}
      tags={tags}
      image={ogImageOf(content, doc.slug)}
    />

    <Provenance doc={doc} />

    <div data-pagefind-ignore>
      <Backlinks slug={doc.slug} graph={content.graph} />
    </div>

    <MarkdownActions href={markdownHref} />
  </article>
</BaseLayout>
