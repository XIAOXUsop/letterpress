---
/**
 * 搜索页。
 *
 * ── 为什么自己写界面而不用 Pagefind 的默认 UI ──────────────────────
 *
 * `@pagefind/default-ui` 自带一整套样式与 DOM 结构。放进这套瑞士排版里
 * 会像贴了一块外来物：圆角、阴影、系统字体、它自己的间距刻度，
 * 全都与设计令牌冲突。改它的 CSS 变量只能改颜色，改不了结构与节奏。
 *
 * 用它的 JS API 自己写大约八十行，换来的是**设计上完全一致**，
 * 而且没有引入一个会把样式注入页面的运行时依赖。
 *
 * ── 中文搜索的实情 ──────────────────────────────────────────────────
 *
 * Pagefind 对 zh-cn 不做词干提取（构建时会打印提示）。中文本来就没有
 * 词形变化，所以这不影响正确性，**但会影响召回**：
 * 「排版」能搜到，而「网页排版」不一定能命中包含「排版」的段落。
 * 这是静态站搜索的固有限制，不是本项目的实现问题——在 README 里如实标注。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config.js';
import { path } from '../lib/url.js';
import searchScript from '../scripts/search.js?raw';
---

<BaseLayout title="搜索" description={`在${site.title}内搜索文章与知识库条目。`}>
  <div class="page-header">
    <h1 class="page-header__title">搜索</h1>
    <p class="page-header__lead">全文检索文章与知识库条目。</p>
  </div>

  {/* 搜索页自身不该被索引——搜「搜索」时冒出来自己很蠢 */}
  <div class="search" id="search" data-pagefind-ignore>
    <form class="search__form" role="search" id="search-form" data-pagefind-url={path('/pagefind/pagefind.js')}>
      <label class="search__label" for="search-input">关键词</label>
      <input
        class="search__input"
        type="search"
        id="search-input"
        name="q"
        autocomplete="off"
        placeholder="输入关键词…"
        style="font-size: max(16px, var(--text-base))"
      />
      {/*
        上面的 style 是为了 iOS Safari：输入框字号小于 16px 时，
        聚焦会强制放大整个页面，把布局毁掉。这不是可选的美化。
      */}
    </form>

    <p class="search__status" id="search-status" role="status" aria-live="polite"></p>
    <ol class="search__results" id="search-results"></ol>
  </div>

  <noscript>
    <p style="color: var(--color-text-muted); margin-block-start: var(--space-5)">
      搜索需要 JavaScript。没有它也能正常阅读——<a href={path('/posts/')}>看全部文章</a>。
    </p>
  </noscript>
</BaseLayout>

<script is:inline type="module" set:html={searchScript} />
