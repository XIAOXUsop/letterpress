---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, unconfiguredFields } from '../config.js';
import { loadContent, reportIssues } from '../lib/content.js';
import { stats as knowledgeStats } from '../lib/wiki/llms.js';
import { path } from '../lib/url.js';

const content = await loadContent();
reportIssues(content.issues);
const s = knowledgeStats(content.docs, content.graph);

const todo = unconfiguredFields();

/**
 * 本站是不是部署在不支持内容协商的平台上。
 *
 * 判据是「GitHub Pages 的域名后缀」——不完美，但足够避免在 Demo 上
 * 说一句不成立的话。真要精确判断得探测响应头，那对一个静态站来说过重了。
 */
const onGitHubPages = site.url.includes('github.io');
---

<BaseLayout title="关于" description={site.author.bio}>
  <div class="page-header">
    <h1 class="page-header__title">关于</h1>
  </div>

  {/*
    还没配置时，先给一份可执行的清单。

    比在 README 里写「记得改配置」有用得多——**用户不会在读 README 时
    顺手改配置，但一定会打开自己的关于页**。而且它避免了在正式页面上
    展示「一句话介绍自己」这种明显的占位文案。
  */}
  {
    todo.length > 0 && (
      <section
        class="setup-notice"
        aria-labelledby="setup-title"
        style="margin-block-end: var(--space-7); padding: var(--space-5); border: 1px solid var(--color-border-strong); border-inline-start-width: 3px; border-inline-start-color: var(--color-accent)"
      >
        <h2 id="setup-title" style="font-size: var(--text-base); font-weight: 600">
          这个站还没配置
        </h2>
        <p style="margin-block: var(--space-3); color: var(--color-text-muted); font-size: var(--text-sm)">
          下面的字段还是出厂默认值。改 <code>src/config.ts</code> 即可，改完这条提示会自动消失。
        </p>
        <ul style="margin: 0; padding-inline-start: var(--space-5); font-size: var(--text-sm)">
          {todo.map((item) => (
            <li style="margin-block-start: var(--space-1)">
              <code>{item}</code>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="prose">
    <p>{site.author.bio}</p>

    {
      site.author.url && todo.length === 0 && (
        <p>
          找到我：<a href={site.author.url}>{site.author.url}</a>
        </p>
      )
    }

    <h2>这个站</h2>
    <p>
      用{' '}
      {site.footer.repoUrl ? (
        <a href={site.footer.repoUrl}>letterpress</a>
      ) : (
        'letterpress'
      )}{' '}
      搭建。内容放在 Git 仓库里，构建出静态文件，不需要数据库，也不需要常驻服务。
    </p>

    <h2>给机器的入口</h2>
    <p>这一站同时写给人和 AI 读，所以除了页面之外还有：</p>
    <ul>
      <li>
        <a href={path('/llms.txt')}>/llms.txt</a>——给 agent 看的目录，标题加一句话说明
      </li>
      <li>
        <a href={path('/llms-full.txt')}>/llms-full.txt</a>——全部内容内联成一份文档
      </li>
      <li>
        <a href={path('/content-manifest.json')}>/content-manifest.json</a>——可版本化的增量同步清单，包含 URL、摘要、链接关系与内容 hash
      </li>
      <li>
        <a href={path('/content.ndjson')}>/content.ndjson</a>——首次全量导入，一行一篇，可流式处理
      </li>
      <li>
        <a href={path('/rss.xml')}>/rss.xml</a>——订阅
      </li>
    </ul>
    <p>
      另外，<strong>文章与知识库条目</strong>都有一个 <code>.md</code> 孪生文件
      （把页面 URL 结尾加 <code>.md</code> 即可）。在支持内容协商的部署平台上，
      对页面 URL 发送 <code>Accept: text/markdown</code> 也能拿到它。
    </p>
    {/*
      Demo 与「模板能做什么」是两件事。

      本站部署在 GitHub Pages，响应头不可改，内容协商不会发生。
      因此显式说明这个限制，并指向始终可用的 .md 孪生文件。
    */}
    {onGitHubPages && (
      <p style="color: var(--color-text-muted); font-size: var(--text-sm)">
        需要说明的是：<strong>本站的内容协商不生效</strong>——它部署在 GitHub Pages 上，
        而该平台不允许改响应头。上面的 <code>.md</code> 文件照常可访问，
        但「带 Accept 头自动切换」需要 Cloudflare Pages / Netlify / Vercel。
        拉下仓库跑 <code>npm run verify</code> 可以实测到真实效果。
      </p>
    )}
    <p>
      另外，<code>llms.txt</code> 的实际效果被高估了——
      有实测显示 97% 的 llms.txt 从未被请求过。这里生成它是因为零成本，
      本站在 GitHub Pages 上依靠显式 <code>.md</code> 链接和内容清单提供机器可读内容。
    </p>

    <h2>内容统计</h2>
  </div>

  <table style="max-width: 32rem">
    <tbody>
      <tr>
        <th scope="row">文章</th>
        <td>{s.posts}</td>
      </tr>
      {
        site.wiki.enabled && (
          <tr>
            <th scope="row">知识库条目</th>
            <td>{s.wikiPages}</td>
          </tr>
        )
      }
      <tr>
        <th scope="row">条目之间的链接</th>
        <td>{s.links}</td>
      </tr>
      <tr>
        <th scope="row">平均每页出链</th>
        <td>{s.avgOutbound}</td>
      </tr>
      {
        s.orphans > 0 && (
          <tr>
            <th scope="row">孤儿页</th>
            <td>{s.orphans}（没有任何页面指向它们）</td>
          </tr>
        )
      }
      {
        content.issues.length > 0 && (
          <tr>
            <th scope="row">体检发现</th>
            <td>{content.issues.length} 条（详见构建日志）</td>
          </tr>
        )
      }
    </tbody>
  </table>
</BaseLayout>
