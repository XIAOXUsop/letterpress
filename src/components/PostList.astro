---
/**
 * 文章/条目列表。
 *
 * 用规则线分隔的行，不用卡片网格。原因不是审美偏好：
 * 等高卡片会把「篇幅」「时效」「主题」这些差别全部抹平，
 * 读者失去判断先读哪篇的依据。行式列表能容纳不等长的信息。
 *
 * 两种变体：
 * - `default`：文章。缩略图 + 日期 + 标题摘要，信息全
 * - `compact`：知识层条目。没有日期（知识层不看时效），排得更紧
 *
 * ── 外层为什么是 div 而不是 a（这里踩过一次）──────────────────────
 *
 * 原先把整行做成 `<a>`，标签也做成 `<a>`——**HTML 不允许 `<a>` 嵌套 `<a>`**。
 * 浏览器解析到内层锚点时会**自动闭合外层**，于是标签整个掉出卡片，
 * 渲染到 `<li>` 下面、缩略图正下方，版式错位。
 *
 * 更麻烦的是它的表现：**DOM 看起来「有那个元素」，只是位置不对**，
 * 所以任何只检查「元素是否存在」「文字是否正确」的断言都发现不了。
 * 我是把页面截图出来看才注意到的。
 *
 * 现在用标准的「拉伸链接」模式：外层是 `div`，标题里的 `<a>` 用伪元素
 * 铺满整行做点击区，标签再提升层级保持独立可点。
 * 整行可点、标签可点，两者都是合法的 HTML。
 */
import type { Doc } from '../lib/wiki/graph.js';
import { coverOf, dateOfDoc, tagsOf, type SiteContent } from '../lib/content.js';
import Cover from './Cover.astro';
import { path } from '../lib/url.js';

interface Props {
  docs: readonly Doc[];
  content: SiteContent;
  variant?: 'default' | 'compact';
}

const { docs, content, variant = 'default' } = Astro.props;
const compact = variant === 'compact';

const formatDate = (date: Date): string =>
  new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date);
---

{
  docs.length === 0 ? (
    <p style="color: var(--color-text-muted)">还没有内容。在 src/content/ 里新建一个 .md 文件即可。</p>
  ) : (
    <ul class:list={['post-list', compact && 'post-list--compact']}>
      {docs.map((doc) => {
        const date = dateOfDoc(content, doc.slug);
        const tags = tagsOf(content, doc.slug);
        const href = path(doc.kind === 'wiki' ? `/wiki/${doc.slug}/` : `/${doc.slug}/`);
        const cover = coverOf(content, doc.slug);
        const withCover = !compact && doc.kind === 'post';

        return (
          <li class="post-list__item">
            <div class:list={['post-list__row', withCover && 'post-list__row--with-cover']}>
              {withCover && (
                <Cover
                  slug={doc.slug}
                  title={doc.title}
                  cover={cover?.src}
                  coverAlt={cover?.alt}
                  thumbnail
                  class="cover cover--thumb"
                />
              )}
              {!compact && <span class="meta">{date ? formatDate(date) : ''}</span>}
              <span class="post-list__body">
                {/* 这个 <a> 是整行的点击区——伪元素铺满 .post-list__row */}
                <a class="post-list__link" href={href}>
                  <span class="post-list__title">{doc.title}</span>
                </a>
                {doc.summary && (
                  <span class="post-list__summary" style="display: block">
                    {doc.summary}
                  </span>
                )}
                {tags.length > 0 && (
                  <span class="meta post-list__tags" style="margin-block-start: var(--space-2)">
                    {tags.map((tag, i) => (
                      <>
                        {i > 0 && <span class="meta__sep"> · </span>}
                        <a href={path(`/tags/${encodeURIComponent(tag)}/`)} class="post-list__tag">
                          {tag}
                        </a>
                      </>
                    ))}
                  </span>
                )}
              </span>
            </div>
          </li>
        );
      })}
    </ul>
  )
}
