---
/**
 * 客户端加载 mermaid 并渲染 `pre.mermaid`。
 *
 * ── 为什么要单独一个组件 ────────────────────────────────────────────
 *
 * **只在这一页有 ` ```mermaid ` 时才加载**——一张 959 KB 的运行时
 * 不该出现在没有图的页面上。与 `pagefind` 同一条理由（它也按需加载）。
 *
 * ── 为什么用运行时而不是构建期 ──────────────────────────────────────
 *
 * 2026-09-29 实测：`remark-mermaid` 最后发布 2018-01-07（依赖 `fs-extra@4`），
 * `rehype-mermaid` 停在 2024-10 且依赖 `mermaid-isomorphic`（puppeteer）。
 * **而构建期起无头浏览器渲染每一张图，会给 46 步的 CI 增加一个几十秒的步骤。**
 * 详见 `src/lib/rehype-mermaid.ts` 的文件头。
 *
 * ── ⚠️⚠️ 为什么**不用** `define:vars`（2026-09-29 实测踩到）────────────
 *
 * 第一版用 `<script is:inline define:vars={{ CDN, theme }}>`，
 * **结果整站 Markdown 的 remark 管线静默失效**：
 * `[[中文排版]]` 原样留在产物里（**而构建退出码是 0**）。
 *
 * 隔离出来的过程：拿掉 `<Mermaid />` → wikilink 正常**且** mermaid 正常；
 * 放回去 → 两者都坏。**所以是组件本身**（不是 rehype 插件）。
 *
 * > **「构建通过」与「功能生效」在输出上完全一样**——
 * > 而这一次的代价是**另一个核心功能**（wiki 链接）静默失效。
 * > 与 `bundle-and-verify` 那次同族：**单跑是绿的、组合起来坏**。
 *
 * 修法：**常量直接写在脚本里**，不用 `define:vars`——
 * 与 `BaseLayout.astro` 里那个 `is:inline` 主题脚本的做法一致
 * （**常量只有一份，版本在下面改**）。
 *
 * ⚠️ **而版本要钉住**：不钉版本 = 页面可能拿到不同的 mermaid，
 * 而图忽然不渲染时**报错信息一个字都不提 mermaid**——极难反推。
 *
 * ⚠️ **而版本号只写在下面那个脚本里**（`MERMAID_CDN`），
 * **不要在 frontmatter 再声明一个常量**——第一版那样写过，
 * 改用 `define:vars` 之后它没人用了，`astro check` 一直报
 * 「declared but its value is never read」，**而那会让编排第 1 步失败**。
 */
---

<script is:inline>
  /*
   * ⚠️ **版本号钉在下面**——与 astro.config.mjs 里没有第二份真值，
   * 而这个「只有一份」正是为了不再引入第三个问题。
   */
  const MERMAID_CDN = 'https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/mermaid.min.js';

  (() => {
    const blocks = Array.from(document.querySelectorAll('pre.mermaid'));
    if (blocks.length === 0) return;
    const sources = new Map(blocks.map((block) => [block, block.textContent ?? '']));
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
    const currentTheme = () => {
      const selected = document.documentElement.dataset.theme;
      return selected === 'dark' || (!selected && prefersDark.matches) ? 'dark' : 'default';
    };

    const script = document.createElement('script');
    script.src = MERMAID_CDN;
    script.onload = () => {
      const m = window.mermaid;
      if (!m) {
        console.warn('[mermaid] 运行时没有提供 mermaid，显示图表源码');
        return;
      }

      let pending = Promise.resolve();
      const render = () => {
        pending = pending.then(async () => {
          m.initialize({ startOnLoad: false, theme: currentTheme() });
          const results = await Promise.allSettled(blocks.map(async (block) => {
            const source = sources.get(block) ?? '';
            block.textContent = source;
            block.removeAttribute('data-processed');
            try {
              await m.run({ nodes: [block] });
              if (block.querySelector('svg[aria-roledescription="error"]')) {
                throw new Error('Mermaid returned an error diagram');
              }
            } catch (error) {
              // Mermaid may replace the source with an error SVG before rejecting.
              block.textContent = source;
              block.removeAttribute('data-processed');
              throw error;
            }
          }));
          const failed = results.filter((result) => result.status === 'rejected').length;
          if (failed > 0) console.warn(`[mermaid] ${failed} 张图渲染失败，已恢复图表源码`);
        });
      };

      render();
      new MutationObserver(render).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
      prefersDark.addEventListener('change', render);
    };
    script.onerror = () => console.warn('[mermaid] 运行时加载失败，显示图表源码');
    document.head.appendChild(script);
  })();
</script>
