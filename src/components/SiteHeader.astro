---
import { site } from '../config.js';
import ThemeToggle from './ThemeToggle.astro';
import { path } from '../lib/url.js';

// 局部变量叫 currentPath 而不是 path——后者已经是上面那个链接构造函数的名字
const currentPath = Astro.url.pathname;

/** 当前项判定。首页要精确匹配，其余按前缀匹配（这样 /posts/foo/ 也算「文章」）。 */
const isCurrent = (href: string): boolean =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href);

// 配置里关掉某项功能时，导航里也不该出现它的入口——
// 留一个指向 404 的链接比不显示更糟。
const nav = [
  ...site.nav,
  ...(site.search.enabled ? [{ label: '搜索', href: '/search/' }] : []),
].filter((item) => site.wiki.enabled || !item.href.startsWith('/wiki'));
---

<header class="site-header">
  <div class="page site-header__inner">
    <a class="site-title" href={path('/')}>{site.title}</a>

    <nav class="site-nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a href={path(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
