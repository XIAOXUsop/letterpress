---
/**
 * JSON-LD 结构化数据。
 *
 * 竞品普遍把它当成「SEO 加分项」，但 2026 年的实际作用是**给 AI 检索用的**：
 * 搜索引擎和 LLM 都靠它确认「这是谁写的、什么时候发的、讲的是什么」。
 * 一段可信的 BlogPosting 比一屏 meta 标签有效得多。
 *
 * 只输出**页面上确实存在的信息**。编造 author.url 或凭空添一个 publisher
 * 会让结构化数据从「信号」变成「噪声」——校验器不报错，但搜索引擎会降权。
 */
import { site } from '../config.js';
import { siteOrigin, basePath } from '../lib/url.js';

interface Props {
  type: 'website' | 'article' | 'note';
  title: string;
  description: string;
  url: string;
  /** 文章专用 */
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: readonly string[];
  /** 文章有封面时传，用于分享卡片 */
  image?: string;
}

const { type, title, description, url, publishedTime, modifiedTime, tags = [], image } = Astro.props;

/**
 * ── 站点地址为空时，绝不回退到 `Astro.url.origin` ──────────────────
 *
 * 构建期的 `Astro.url.origin` 是 `http://localhost:4321`——**那个值会被
 * 原样写进产物**，于是线上页面的结构化数据里声明自己是 localhost。
 *
 * 搜索引擎拿到这种数据会直接判定为无效，而这比没有结构化数据更糟：
 * 没有至少是中性的，错的会主动传递错误信息。
 *
 * 所以 `site.url` 为空时改用**相对路径**——搜索引擎会按页面地址解析。
 * 不是最优解，但方向是对的。
 */
/*
 * `site.url` 里可能已经带了一次部署路径，先剥掉再交给 `absolute` 加——
 * 否则结构化数据里会出现 `/letterpress/letterpress/letterpress/...`。
 */
const base = siteOrigin(site.url);
const deployBase = basePath();

/**
 * 传进来的路径**可能已经含 base**。
 *
 * 页面传的是 `Astro.url.pathname`，而它带着部署前缀
 * （子路径部署下是 `/letterpress/cjk-web-typography/`）。
 * 直接再拼一次 base 就是三层前缀——实测正是这么错的。
 *
 * 所以先剥掉可能存在的 base 前缀，再统一加上。这样无论调用方传的是
 * 带前缀的还是不带的，结果都对。
 */
const stripBase = (p: string): string =>
  deployBase && p.startsWith(deployBase) ? p.slice(deployBase.length) : p;

const absolute = (p: string): string =>
  p.startsWith('http') ? p : `${base}${deployBase}${stripBase(p)}`;

/** `@id` 需要绝对地址才有意义，没有站点域名时干脆不输出。 */
const idFor = (fragment: string): string | undefined =>
  base ? `${base}${deployBase}/${fragment}` : undefined;

const websiteId = idFor('#website');
const personId = idFor('#person');

/**
 * 用 @graph 把多个实体放在一个 script 里。
 *
 * 比在每个页面重复 `publisher` 之类的共有信息更省，而且实体之间可以
 * 用 `@id` 互相引用——搜索引擎能因此把「这个作者的所有文章」连起来。
 */
const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    ...(websiteId ? { '@id': websiteId } : {}),
    name: site.title,
    description: site.tagline,
    // 必须带上部署路径：少了它，@id 与 url 会指向两个不同的地址
    ...(base ? { url: `${base}${deployBase}` } : {}),
    inLanguage: site.lang,
    ...(personId ? { publisher: { '@id': personId } } : {}),
  },
  {
    '@type': 'Person',
    ...(personId ? { '@id': personId } : {}),
    name: site.author.name,
    description: site.author.bio,
    // 只在真的填了主页时才输出 url——空字符串会让校验器报错
    ...(site.author.url ? { url: site.author.url } : {}),
  },
];

if (type === 'article' && publishedTime) {
  const articleId = base ? `${absolute(url)}#article` : undefined;

  graph.push({
    '@type': 'BlogPosting',
    ...(articleId ? { '@id': articleId } : {}),
    headline: title,
    description,
    ...(base ? { url: absolute(url), mainEntityOfPage: { '@id': articleId } } : { mainEntityOfPage: url }),
    datePublished: publishedTime.toISOString(),
    /*
     * `dateModified` 用 `updated` 字段，没有则退回发布时间。
     *
     * 这一条对搜索引擎是**实质性信号**：能区分「刚发布」与「发布后大改过」。
     * 竞品里 astro-paper 与 PaperMod 都输出它，而 `updated` 这个数据
     * 本项目早就有、只是没往外输出。
     */
    dateModified: (modifiedTime ?? publishedTime).toISOString(),
    ...(personId ? { author: { '@id': personId }, publisher: { '@id': personId } } : {}),
    inLanguage: site.lang,
    ...(image && base ? { image: absolute(image) } : {}),
    ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
    ...(websiteId ? { isPartOf: { '@id': websiteId } } : {}),
  });
}

/*
 * 知识库条目。
 *
 * ⚠️ **2026-09-24 补的**——此前 `type` 枚举里就有 `'note'`，
 * 但**实现里只处理了 `'article'`**，于是 wiki 路由传 `note` 进来
 * 什么也不输出：**声明了能力而没接线**，症状是那一类页面完全没有 JSON-LD。
 * 而 wiki 路由（`src/pages/wiki/[slug].astro`）**根本没引入本组件**——
 * 所以那不只是「分支没写」，是**整条路没通**。
 *
 * ── 为什么是 `Article` 而不是 `TechArticle` ─────────────────────────
 *
 * `TechArticle` 语义上更贴（它就是「技术文章」），但 2026-09-24 实测
 * **schema.org 在本机网络下取不到**（页面超时、机器可读端点 404），
 * **无法核实它的父类型与当前定义**。
 *
 * > **查不到就不写。** 写一个自己没核实过的 `@type`，
 * > 比用一个确定存在的上位类更糟——`Article` 一定有效，
 * > 而错误的类型名会让搜索引擎**静默忽略这一整块**。
 *
 * `Article` 是 `BlogPosting` 的父类，语义上「一篇解释性页面」正合适；
 * 若将来能联网核实 `TechArticle` 仍然有效，改这一处即可。
 */
if (type === 'note') {
  const noteId = base ? `${absolute(url)}#article` : undefined;
  graph.push({
    '@type': 'Article',
    ...(noteId ? { '@id': noteId } : {}),
    headline: title,
    description,
    ...(base ? { url: absolute(url), mainEntityOfPage: { '@id': noteId } } : { mainEntityOfPage: url }),
    // 知识页没有「发布时间」——它是持续修订的。
    // 只给 dateModified：**给一个假的 datePublished 反而会误导**。
    ...(modifiedTime ? { dateModified: modifiedTime.toISOString() } : {}),
    ...(personId ? { author: { '@id': personId }, publisher: { '@id': personId } } : {}),
    inLanguage: site.lang,
    ...(image && base ? { image: absolute(image) } : {}),
    ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
    ...(websiteId ? { isPartOf: { '@id': websiteId } } : {}),
  });
}
---

<script type="application/ld+json" is:inline set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
