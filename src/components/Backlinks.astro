---
/**
 * 反向链接：「哪些页面引用了这里」。
 *
 * 这是知识层相对普通博客最直接的可感知差别。一篇文章是一个点，
 * 反向链接让它变成一个**有来路的点**——读者能顺着找到上下文，
 * 而不是读完就沉底。
 *
 * 每一条都显示来源页作者写下的**显示文本**而不只是标题：
 * 「见 [[内容协商|那篇讲 Accept 头的]]」里，
 * 「那篇讲 Accept 头的」才是作者对这个链接的定位。
 */
import type { LinkGraph } from '../lib/wiki/graph.js';
import { path } from '../lib/url.js';

interface Props {
  slug: string;
  graph: LinkGraph;
}

const { slug, graph } = Astro.props;
const links = graph.backlinks.get(slug) ?? [];
---

{
  links.length > 0 && (
    <section class="backlinks" aria-labelledby="backlinks-title">
      <h2 class="backlinks__title" id="backlinks-title">
        被这些页面引用（{links.length}）
      </h2>
      <ul class="backlinks__list">
        {links.map((link) => {
          const target = graph.bySlug.get(link.fromSlug);
          const href = path(target?.kind === 'wiki' ? `/wiki/${link.fromSlug}/` : `/${link.fromSlug}/`);
          return (
            <li>
              <a href={href}>{link.fromTitle}</a>
              {link.label !== link.fromTitle && link.label !== slug && (
                <span class="meta" style="display: inline; margin-inline-start: var(--space-2)">
                  「{link.label}」
                </span>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )
}
