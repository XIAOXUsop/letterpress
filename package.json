{
  "name": "letterpress",
  "type": "module",
  "version": "0.1.0",
  "description": "一个把中文排版做对、同时写给人和 AI 读的静态博客主题",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:noindex": "astro build",
    "preview": "astro preview",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.verify/vitest-report.json",
    "test:watch": "vitest",
    "check": "astro check",
    "clean": "node scripts/clean.mjs",
    "sync:content": "node scripts/sync-content.mjs",
    "verify": "npm run clean && npm run build && node scripts/bundle-and-verify.mjs",
    "verify:only": "node scripts/bundle-and-verify.mjs",
    "verify:testcount": "node scripts/check-test-count.mjs",
    "verify:anchors": "node scripts/check-anchors.mjs",
    "wiki:review": "node scripts/wiki-review.mjs",
    "wiki:impact": "node scripts/wiki-impact.mjs",
    "verify:base": "node scripts/check-base.mjs",
    "verify:all": "npm run check && npm run verify:gates && npm test && npm run verify && npm run verify:testcount && npm run verify:search && npm run verify:questions && npm run verify:retrieval-gates && npm run verify:impact && npm run verify:answers && npm run verify:review && npm run verify:portability && npm run check:site-agnostic && npm run verify:site-mutations && npm run check:exit-codes && npm run verify:exit-codes && npm run verify:json-output && npm run verify:json-mutations && npm run verify:migrate && npm run check:single-source && npm run verify:second-site && npm run verify:second-site-real && npm run verify:second-site-real-mutations && npm run verify:anchors && npm run verify:reproducible && npm run verify:base && npm run check:manifest-schema && npm run verify:formats && npm run check:anchors && npm run check:refs && npm run check:agents-doc && npm run check:staged",
    "verify:formats": "node scripts/check-formats.mjs",
    "verify:online": "node scripts/smoke-online.mjs",
    "verify:reproducible": "node scripts/check-reproducible.mjs",
    "verify:search": "node scripts/check-search.mjs",
    "wiki:ask": "node scripts/wiki-ask.mjs",
    "verify:questions": "node scripts/check-questions.mjs",
    "verify:impact": "node scripts/check-impact.mjs",
    "verify:portability": "node scripts/check-portability.mjs",
    "verify:second-site": "node scripts/check-second-site.mjs",
    "list:overclaims": "node scripts/list-overclaims.mjs",
    "measure": "node scripts/measure.mjs",
    "verify:gates": "node scripts/check-gate-list.mjs",
    "verify:answers": "node scripts/check-answers.mjs",
    "check:refs": "node scripts/check-doc-refs.mjs",
    "check:anchors": "node scripts/check-anchor-links.mjs",
    "check:site-agnostic": "node scripts/check-site-agnostic.mjs",
    "verify:site-mutations": "node scripts/site-agnostic.mutations.mjs",
    "check:exit-codes": "node scripts/check-exit-codes.mjs",
    "verify:exit-codes": "node scripts/exit-codes.mutations.mjs",
    "migrate:manifest": "node scripts/migrate-manifest.mjs",
    "verify:migrate": "node scripts/migrate-manifest.mutations.mjs",
    "check:single-source": "node scripts/check-single-source.mjs",
    "verify:review": "node scripts/check-review-status.mjs",
    "verify:json-output": "node scripts/check-json-output.mjs",
    "verify:json-mutations": "node scripts/json-output.mutations.mjs",
    "verify:second-site-real": "node scripts/check-second-site-real.mjs",
    "verify:second-site-real-mutations": "node scripts/second-site-real.mutations.mjs",
    "check:manifest-schema": "npm run build && node scripts/check-manifest-schema.mjs",
    "check:agents-doc": "node scripts/check-agents-doc.mjs",
    "check:staged": "node scripts/check-staged.mjs",
    "verify:retrieval-gates": "node scripts/retrieval-gates.mutations.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "astro": "^7.3.2",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "ajv": "^8.20.0",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
