{
  "name": "letterpress",
  "type": "module",
  "version": "0.1.0",
  "description": "一个把中文排版做对、同时写给人和 AI 读的静态博客主题",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "astro check",
    "clean": "node -e \"for (const d of ['.astro','dist']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "verify": "npm run clean && npm run build && node scripts/bundle-and-verify.mjs",
    "verify:only": "node scripts/bundle-and-verify.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "astro": "^7.3.2",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "vite": "^8.0.13",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
